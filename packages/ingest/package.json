{
	"name": "graphx-ingest",
	"version": "0.1.0",
	"description": "Ingest a YAML/markdown vault into a graphx graph",
	"homepage": "https://graphx.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/graphx/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git",
		"directory": "packages/ingest"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./s3": {
			"import": {
				"types": "./dist/s3.d.ts",
				"default": "./dist/s3.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"gray-matter": "^4.0.3"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@types/node": "^25.9.1",
		"graphx-core": "workspace:*",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"graphx-core": "workspace:*",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
