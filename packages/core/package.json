{
	"name": "@graphx/core",
	"version": "0.1.0",
	"description": "Temporal GraphRAG SDK on libSQL or Postgres — typed schema, bitemporal graph, vector + FTS retrieval, and a served HTTP API",
	"homepage": "https://github.com/TimMikeladze/graphx/tree/main/packages/core#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./pg": {
			"import": {
				"types": "./dist/pg.d.ts",
				"default": "./dist/pg.js"
			}
		},
		"./duck": {
			"import": {
				"types": "./dist/duck.d.ts",
				"default": "./dist/duck.js"
			}
		},
		"./blob": {
			"import": {
				"types": "./dist/blob.d.ts",
				"default": "./dist/blob.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.5.1",
		"@hono/zod-validator": "^0.9.0",
		"@libsql/client": "^0.17.3",
		"hono": "^4.12.23",
		"ulidx": "^2.4.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@aws-sdk/s3-request-presigner": "^3.0.0",
		"@duckdb/node-api": "1.5.5-r.2",
		"@seriousme/openapi-schema-validator": "^2.9.0",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.11.10",
		"ajv": "^8.20.0",
		"pg": "^8.13.1"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@aws-sdk/s3-request-presigner": "^3.0.0",
		"@duckdb/node-api": "^1.5.5-r.2",
		"pg": "^8.11.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		},
		"@duckdb/node-api": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
