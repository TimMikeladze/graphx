{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["bun", "node"],
		"jsx": "preserve",
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./*"] }
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "data"]
}
