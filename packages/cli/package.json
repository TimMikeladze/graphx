{
	"name": "graphx-cli",
	"version": "0.1.0",
	"description": "graphx CLI — scaffold, ingest, serve, and run triggers over a graphx graph",
	"homepage": "https://graphx.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/graphx/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git",
		"directory": "packages/cli"
	},
	"bin": {
		"graphx": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/cli.js",
	"types": "./dist/cli.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/cli.d.ts",
				"default": "./dist/cli.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"graphx-core": "workspace:*",
		"graphx-ingest": "workspace:*"
	},
	"peerDependencies": {
		"graphx-core": "workspace:*",
		"graphx-ingest": "workspace:*",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
