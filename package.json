{
	"name": "graphx-monorepo",
	"private": true,
	"homepage": "https://github.com/TimMikeladze/graphx#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/graphx/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"bench": "bun scripts/bench/index.ts",
		"build": "bunup",
		"clean:db": "bun scripts/clean-db.ts",
		"dev": "bunup --watch",
		"dev:admin": "bun scripts/dev-admin.ts",
		"dev:admin:api": "bun scripts/admin-api.ts",
		"dev:pantheon": "bun scripts/dev-admin.ts examples/pantheon-graph/server.ts 8788",
		"dev:skills": "bun scripts/dev-admin.ts examples/skills-graph/server.ts 8789",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp -r --commit --push --tag",
		"test": "bun test --timeout 30000",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "bun run --filter '*' type-check"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"bumpp": "^11.1.0",
		"bunup": "^0.16.32",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check && bun run clean:db"
	}
}
