{
	"name": "graphx-monorepo",
	"private": true,
	"description": "Monorepo for graphx — temporal GraphRAG on libSQL/SQLite, Postgres, or DuckDB. Holds the graphx package, the admin SPA, the graphx.sh landing page, and the examples.",
	"keywords": [
		"bitemporal",
		"bun",
		"duckdb",
		"embeddings",
		"full-text-search",
		"graph",
		"graph-database",
		"graphrag",
		"hono",
		"knowledge-graph",
		"libsql",
		"mcp",
		"model-context-protocol",
		"openapi",
		"postgres",
		"rag",
		"react-query",
		"rebac",
		"sqlite",
		"temporal",
		"typescript",
		"vector-search",
		"zod"
	],
	"homepage": "https://graphx.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/graphx/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tim Mikeladze",
		"email": "tim.mikeladze@gmail.com",
		"url": "https://github.com/TimMikeladze"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"bench": "bun scripts/bench/index.ts",
		"bench:benchable": "bun scripts/bench/benchable.ts",
		"build": "bunup",
		"clean:db": "bun scripts/clean-db.ts",
		"dev": "bunup --watch",
		"dev:admin": "bun scripts/dev-admin.ts",
		"dev:admin:api": "bun scripts/admin-api.ts",
		"dev:pantheon": "bun scripts/dev-admin.ts examples/pantheon-graph/server.ts 8788",
		"dev:skills": "bun scripts/dev-admin.ts examples/skills-graph/server.ts 8789",
		"dev:mma": "bun run --filter graphx-example-mma-graph dev",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp -r --commit --push --tag",
		"sync:readme": "bun scripts/sync-package-readme.ts",
		"test": "bun test --timeout 30000",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"bql:serve": "bun scripts/bql-server.ts",
		"bql:build": "bun run node_modules/bql.sh/packages/db/scripts/sqlite.ts",
		"type-check": "bun run --filter '*' type-check"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"bumpp": "^11.1.0",
		"bunup": "^0.16.32",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check && bun run clean:db"
	}
}
