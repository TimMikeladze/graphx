		"bitemporal",
		"bun",
		"duckdb",
		"embeddings",
		"full-text-search",
		"graph",
		"graph-database",
		"graphrag",
		"hono",
		"knowledge-graph",
		"libsql",
		"mcp",
		"model-context-protocol",
		"openapi",
		"postgres",
		"rag",
		"react-query",
		"rebac",
		"sqlite",
		"temporal",
		"typescript",
		"vector-search",
		"zod"
	],
	"homepage": "https://graphx.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/graphx/issues"
	},
	"license": "MIT",
	"author": {
