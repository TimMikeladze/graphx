{
	"name": "core",
	"version": "0.1.0",
	"description": "Elegant and performant component library",
	"homepage": "https://github.com/TimMikeladze/graphx/tree/main/packages/core#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/graphx.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./pg": {
			"import": {
				"types": "./dist/pg.d.ts",
				"default": "./dist/pg.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.8.0",
		"@libsql/client": "^0.17.3",
		"hono": "^4.12.23",
		"ulidx": "^2.4.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/pg": "^8.11.10",
		"pg": "^8.13.1"
	},
	"peerDependencies": {
		"pg": "^8.11.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"pg": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
