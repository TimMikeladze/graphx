# Rebuild fingerprint for the admin dev server's demo databases (scripts/seed) and for the
# collector-backed examples (examples/pantheon-graph, examples/skills-graph). Unanchored, so it
# matches beside whichever server built the database.
.seed-cache.json

# scripts/bench output — cached corpora and run results. Anchored to the root so it does not also
# swallow scripts/bench, which is the harness itself.
/bench/

# Agent scratch: git worktrees and per-plan SDD workspaces (ledgers, briefs, review packages).
/.claude/worktrees/
/.superpowers/

# Playwright MCP scratch: snapshots, console logs and screenshots from driving the admin UI.
.playwright-mcp/

# DuckDB scratch databases + spill (see duck-pool.ts duckDataDir)
.graphx-data/
.vercel

# Scratch directory the README-examples test compiles in (inside the repo so `graphx` resolves).
.readme-examples-*/
